/* ubKeybind Editor — styles.
 * RmlUi notes (proven in the prototype):
 *  - display:table is unreliable; rows are flexbox.
 *  - everything defaults to display:block via the universal rule.
 *
 * Visual system:
 *  - spacing scale: 4 / 8 / 12 / 16 dp; horizontal gutter is 16dp everywhere.
 *  - accent: rgb(255, 220, 120) (BAR yellow); danger: rgb(255, 120, 100).
 *  - text: white at full strength for primary, alpha 150-ish for secondary.
 */

* {
	font-family: "Exo 2";
	display: block;
}

body {
	width: 52vw;
	height: 82vh;
	max-width: 700dp;

	position: absolute;
	top: 9vh;
	left: 10vw;

	/* RmlUi's default is a small 12px; everything below is em-based and
	 * scales off this. */
	font-size: 16dp;
	color: rgb(235, 235, 235);
}

.window {
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 100%;
	border: 1dp rgba(255, 255, 255, 70);
}

/* "Exo 2" has a deep descender, so a symmetric box leaves visibly more
 * space under caps-height text than above it. All button-like boxes use
 * ~4dp extra top padding to optically center the glyphs. */
button {
	background: rgba(0, 0, 0, 200);
	min-width: 24dp;
	min-height: 24dp;
	padding: 6dp 8dp 2dp 8dp;
	display: inline-block;
	text-align: center;
	border: 1dp rgba(255, 255, 255, 90);
	border-radius: 3dp;
	color: rgb(255, 255, 255);
}
button:hover {
	border-color: rgba(255, 255, 255, 200);
	background: rgba(40, 40, 40, 220);
}
button:active {
	background: rgba(255, 220, 120, 40);
	border-color: rgba(255, 220, 120, 200);
}

/* -------------------------------------------------- titlebar */

.titlebar {
	flex-shrink: 0;
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 10dp 16dp;
	background: rgba(0, 0, 0, 240);
	border-bottom: 1dp rgba(255, 255, 255, 70);
}
.title {
	display: inline-block;
	flex: 1;
	font-size: 1.4em;
	font-weight: bold;
}
.debug-controls {
	display: inline-block;
}
.chrome-button {
	margin-left: 6dp;
	min-width: 28dp;
	padding: 6dp 6dp 2dp 6dp;
	font-weight: bold;
	color: rgba(255, 255, 255, 190);
}
.chrome-button:hover {
	color: rgb(255, 255, 255);
}
.close-button:hover {
	background: rgba(160, 40, 40, 220);
	border-color: rgba(255, 120, 100, 220);
}

/* -------------------------------------------------- toolbar */

.toolbar {
	flex-shrink: 0;
	display: flex;
	flex-direction: row;
	align-items: center;
	background: rgba(0, 0, 0, 220);
	padding: 10dp 16dp;
	border-bottom: 1dp rgba(255, 255, 255, 70);
}
.search-input {
	display: inline-block;
	width: 45%;
	min-height: 28dp;
	padding: 6dp 10dp 2dp 10dp;
	background: rgba(255, 255, 255, 15);
	border: 1dp rgba(255, 255, 255, 80);
	border-radius: 3dp;
	color: rgb(255, 255, 255);
}
.search-input:hover {
	border-color: rgba(255, 255, 255, 140);
}
.search-input:focus {
	border-color: rgba(255, 220, 120, 200);
	background: rgba(255, 255, 255, 25);
}
.status-line {
	display: inline-block;
	flex: 1;
	text-align: right;
	color: rgba(255, 255, 255, 150);
	font-size: 0.9em;
}

/* -------------------------------------------------- filter bar */

.filter-bar {
	flex-shrink: 0;
	display: flex;
	flex-direction: row;
	align-items: center;
	background: rgba(0, 0, 0, 200);
	padding: 8dp 16dp;
	border-bottom: 1dp rgba(255, 255, 255, 70);
}
.filter-label {
	display: inline-block;
	margin-right: 10dp;
	color: rgba(255, 255, 255, 140);
	font-size: 0.9em;
}
.filter-button {
	margin-right: 6dp;
	padding: 5dp 12dp 1dp 12dp;
	min-height: 22dp;
	font-size: 0.9em;
	color: rgba(255, 255, 255, 190);
}
.filter-button:hover {
	color: rgb(255, 255, 255);
}
.filter-button.active {
	background: rgba(255, 220, 120, 50);
	border-color: rgba(255, 220, 120, 200);
	color: rgb(255, 220, 120);
}
.filter-button-unbound {
	margin-left: 14dp;
}
.filter-spacer {
	display: inline-block;
	flex: 1;
}
.collapse-all-button {
	margin-right: 0;
	white-space: nowrap;
}
/* Label spans inside the button (universal rule would make them block). */
.collapse-label {
	display: inline;
}

/* -------------------------------------------------- content + scrollbar */

.content {
	flex: 1;
	min-height: 0;
	overflow-y: auto;
	background: rgba(0, 0, 0, 200);
	padding: 10dp 16dp 16dp 16dp;
}

.content scrollbarvertical {
	width: 8dp;
	margin-left: 6dp;
}
.content scrollbarvertical slidertrack {
	background: rgba(255, 255, 255, 20);
	border-radius: 4dp;
}
.content scrollbarvertical sliderbar {
	background: rgba(255, 255, 255, 80);
	border-radius: 4dp;
	min-height: 30dp;
}
.content scrollbarvertical sliderbar:hover {
	background: rgba(255, 255, 255, 140);
}
.content scrollbarvertical sliderbar:active {
	background: rgba(255, 220, 120, 220);
}
.content scrollbarvertical sliderarrowdec,
.content scrollbarvertical sliderarrowinc {
	display: none;
}

/* -------------------------------------------------- categories */

.category {
	margin-bottom: 18dp;
}
.category.hidden {
	display: none;
}
.category-title {
	display: flex;
	flex-direction: row;
	align-items: center;
	font-weight: bold;
	font-size: 1.1em;
	margin-bottom: 4dp;
	padding: 5dp 4dp;
	border-bottom: 1dp rgba(255, 255, 255, 60);
}
.category-title:hover {
	color: rgb(255, 220, 120);
	background: rgba(255, 255, 255, 10);
}
.caret {
	display: inline-block;
	width: 16dp;
	text-align: center;
	color: rgba(255, 255, 255, 140);
}
.category-title:hover .caret {
	color: rgb(255, 220, 120);
}
.category-name {
	display: inline-block;
}
.category-count {
	display: inline-block;
	margin-left: 8dp;
	color: rgba(255, 255, 255, 110);
	font-size: 0.8em;
	font-weight: normal;
}
.category.collapsed .rows {
	display: none;
}

/* -------------------------------------------------- rows */

.rows {
	width: 100%;
}
.row {
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 100%;
	padding: 2dp 4dp;
	border-bottom: 1dp rgba(255, 255, 255, 25);
}
.row:hover {
	background: rgba(255, 255, 255, 10);
}
.row.hidden {
	display: none;
}
.row.locked .row-label {
	color: rgba(255, 255, 255, 120);
}
.row.locked .col-binding {
	color: rgba(255, 255, 255, 110);
	background: rgba(20, 20, 20, 160);
	border-color: rgba(255, 255, 255, 40);
}
.row.locked .col-binding:hover {
	background: rgba(20, 20, 20, 160);
	border-color: rgba(255, 255, 255, 40);
}

.col-label {
	flex-grow: 2;
	flex-shrink: 1;
	flex-basis: 0;
	padding: 2dp 8dp 2dp 4dp;
}
.row-label {
	display: inline;
}
.badge {
	display: inline-block;
	margin-left: 6dp;
	min-width: 14dp;
	text-align: center;
	font-weight: bold;
	border-radius: 3dp;
}
.badge-override {
	color: rgb(255, 220, 120);
}
.badge-conflict {
	color: rgb(255, 120, 100);
	border: 1dp rgba(255, 120, 100, 160);
}
.reset-button {
	display: inline-block;
	margin-left: 8dp;
	color: rgba(255, 255, 255, 140);
	font-size: 0.8em;
	text-decoration: underline;
}
.reset-button:hover {
	color: rgb(255, 220, 120);
}

.col-binding {
	flex-grow: 0;
	flex-shrink: 0;
	flex-basis: 128dp;
	margin: 3dp 0 3dp 8dp;
	/* flex-centered, so the offset is half the top/bottom difference; keep a
	 * real bottom pad so descenders never sit on the box edge */
	padding: 5dp 10dp 3dp 10dp;
	min-height: 28dp;
	white-space: nowrap;
	overflow: hidden;
	display: flex;
	align-items: center;
	justify-content: center;
	background: rgba(30, 30, 30, 200);
	border: 1dp rgba(255, 255, 255, 80);
	border-radius: 3dp;
}
.col-binding:hover {
	border-color: rgba(255, 220, 120, 200);
	background: rgba(50, 50, 50, 230);
}
.col-binding.unbound {
	color: rgba(255, 255, 255, 90);
	background: rgba(20, 20, 20, 140);
	border-color: rgba(255, 255, 255, 30);
}
.col-binding.unbound:hover {
	color: rgba(255, 255, 255, 160);
}
.binding-text {
	display: inline;
}

/* -------------------------------------------------- footer */

.footer {
	flex-shrink: 0;
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 10dp 16dp;
	background: rgba(0, 0, 0, 240);
	border-top: 1dp rgba(255, 255, 255, 70);
}
.footer-hint {
	display: inline-block;
	flex: 1;
	color: rgba(255, 255, 255, 130);
	font-size: 0.85em;
	padding-right: 12dp;
}
.footer-button {
	margin-left: 8dp;
	padding: 6dp 14dp 2dp 14dp;
	white-space: nowrap;
}

/* -------------------------------------------------- tooltips
 * RmlUi's `title` attribute is NOT rendered as a hover tooltip by this
 * engine build (confirmed: no widget in the game uses it, BAR's real
 * tooltip system is the screen-space WG['tooltip'] overlay, entirely
 * separate from RmlUi). Tooltips here are pure CSS: a hidden bubble shown
 * via :hover on a `.has-tooltip` ancestor.
 */

.has-tooltip {
	position: relative;
}
.tooltip-bubble {
	display: none;
	position: absolute;
	top: 100%;
	left: 0;
	margin-top: 4dp;
	padding: 5dp 8dp;
	background: rgba(15, 15, 15, 245);
	border: 1dp rgba(255, 255, 255, 100);
	border-radius: 3dp;
	color: rgb(230, 230, 230);
	font-size: 0.85em;
	font-weight: normal;
	text-decoration: none;
	text-align: left;
	z-index: 10;
	/* `width: auto` on an absolutely-positioned box resolves to the
	 * containing block's own width here (e.g. the button/badge it's
	 * anchored to), not a shrink-to-fit of the text — neither display:block
	 * nor inline-block changes that. Sidestep it with a fixed width and
	 * let text wrap instead of relying on auto-sizing + nowrap. */
	width: 200dp;
	white-space: normal;
}
.has-tooltip:hover .tooltip-bubble {
	display: block;
}

/* -------------------------------------------------- capture overlay (M3) */

.capture-overlay {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	background: rgba(0, 0, 0, 160);
	display: flex;
	align-items: center;
	justify-content: center;
}
.capture-box {
	width: 40%;
	min-width: 320dp;
	padding: 20dp 24dp;
	background: rgba(10, 10, 10, 245);
	border: 1dp rgba(255, 220, 120, 200);
	border-radius: 4dp;
	text-align: center;
}
.capture-title {
	font-size: 1.2em;
	font-weight: bold;
	margin-bottom: 12dp;
}
.capture-keys {
	font-size: 1.6em;
	min-height: 32dp;
	margin-bottom: 12dp;
	color: rgb(255, 220, 120);
}
.capture-conflicts {
	color: rgb(255, 120, 100);
	margin-bottom: 8dp;
}
.capture-buttons {
	display: flex;
	flex-direction: row;
	justify-content: center;
	margin-bottom: 12dp;
}
.capture-button {
	margin: 0 5dp;
	padding: 7dp 16dp 3dp 16dp;
}
.capture-hint {
	color: rgba(255, 255, 255, 130);
	font-size: 0.85em;
}
