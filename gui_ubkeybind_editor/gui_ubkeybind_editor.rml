<rml>

	<head>
		<title>Keybind Editor</title>
		<link rel="stylesheet" href="gui_ubkeybind_editor.rcss" type="text/rcss" />
	</head>

	<body id="ubke" data-model="ubke_model">
		<div class="window">
			<div class="titlebar">
				<span class="title">Keybind Editor</span>
				<div class="debug-controls" data-if="ui.debug">
					<button class="has-tooltip" onclick="widget:Reload()">R<span class="tooltip-bubble">Reload Widget</span></button>
				</div>
				<button class="chrome-button has-tooltip" onclick="widget:ToggleDebugger()">D<span class="tooltip-bubble">Toggle Debugger</span></button>
				<button class="chrome-button close-button has-tooltip" onclick="widget:Close()">X<span class="tooltip-bubble">Close</span></button>
			</div>

			<div class="toolbar">
				<input id="ubke-search" type="text" class="search-input" placeholder="Search actions or keys..."
					onchange="widget:OnSearchChanged(event)" onfocus="widget:OnSearchFocus()" />
				<span class="status-line">{{ ui.statusLine }}</span>
			</div>

			<div class="filter-bar">
				<span class="filter-label">Show:</span>
				<button class="filter-button" data-class-active="ui.levelFilter == 'common'"
					data-event-click="filterClick = 'common'">Common</button>
				<button class="filter-button" data-class-active="ui.levelFilter == 'uncommon'"
					data-event-click="filterClick = 'uncommon'">Uncommon</button>
				<button class="filter-button" data-class-active="ui.levelFilter == 'advanced'"
					data-event-click="filterClick = 'advanced'">Advanced</button>
				<button class="filter-button" data-class-active="ui.levelFilter == 'all'"
					data-event-click="filterClick = 'all'">All</button>
				<button class="filter-button filter-button-unbound has-tooltip" data-class-active="ui.unboundOnly"
					data-event-click="unboundToggle = true">Unbound only<span class="tooltip-bubble">Show only actions with no primary or secondary bind</span></button>
				<span class="filter-spacer"></span>
				<button class="filter-button collapse-all-button" data-event-click="collapseToggle = true">
					<span class="collapse-label" data-if="!ui.allCollapsed">Collapse all</span>
					<span class="collapse-label" data-if="ui.allCollapsed">Expand all</span>
				</button>
			</div>

			<div class="content">
				<div class="category" data-for="category : view.categories"
					data-class-collapsed="category.collapsed" data-class-hidden="!category.visible">
					<div class="category-title" data-event-click="category.collapsed = !category.collapsed">
						<span class="caret" data-if="!category.collapsed">-</span>
						<span class="caret" data-if="category.collapsed">+</span>
						<span class="category-name">{{ category.label }}</span>
						<span class="category-count">{{ category.matchCount }}</span>
					</div>
					<div class="rows">
						<div class="row" data-for="row : category.rows"
							data-class-hidden="!row.visible" data-class-locked="row.locked">
							<div class="col-label has-tooltip">
								<span class="row-label">{{ row.label }}</span>
								<span class="badge badge-override has-tooltip" data-if="row.overridden">*<span class="tooltip-bubble">Changed from preset default</span></span>
								<span class="badge badge-conflict has-tooltip" data-if="row.conflicted">!<span class="tooltip-bubble">Shares a key with another action</span></span>
								<span class="reset-button has-tooltip" data-if="row.overridden" data-event-click="event = row.resetEvent">Reset<span class="tooltip-bubble">Revert to preset default</span></span>
								<span class="tooltip-bubble" data-if="row.tooltip != ''">{{ row.tooltip }}</span>
							</div>
							<div class="col-binding col-primary" data-class-unbound="!row.primary.bound"
								data-event-click="event = row.primaryEvent">
								<span class="binding-text">{{ row.primary.display }}</span>
							</div>
							<div class="col-binding col-secondary" data-class-unbound="!row.secondary.bound"
								data-event-click="event = row.secondaryEvent">
								<span class="binding-text">{{ row.secondary.display }}</span>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="footer">
				<span class="footer-hint">Click a binding to change it.</span>
				<button class="footer-button" onclick="widget:RevertAll()">Reset All</button>
				<button class="footer-button" onclick="widget:Resync()">Resync</button>
			</div>
		</div>

		<div class="capture-overlay" data-if="capture.active">
			<div class="capture-box">
				<div class="capture-title">Press keys for: {{ capture.actionLabel }}</div>
				<div class="capture-keys">{{ capture.pendingDisplay }}</div>
				<div class="capture-conflicts" data-if="capture.hasConflicts">{{ capture.conflictText }}</div>
				<div class="capture-buttons">
					<button class="capture-button" onclick="widget:CaptureAccept()">Accept</button>
					<button class="capture-button" onclick="widget:CaptureUnbind()">Unbind</button>
					<button class="capture-button" onclick="widget:CaptureCancel()">Cancel</button>
				</div>
				<div class="capture-hint">Esc cancels  -  second key within 0.7s makes a chain  -  click Accept to apply</div>
			</div>
		</div>
	</body>
</rml>
